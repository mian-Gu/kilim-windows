 FILEVERSION KILIM_FILEVERSION
 PRODUCTVERSION KILIM_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
