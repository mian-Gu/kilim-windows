   VALUE "ProductName", "Kilim"
   VALUE "ProductVersion", KILIM_VERSIONTEXT
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
